<?xml version="1.0"?>
<package format="3">
  <name>robotlidar</name>
  <version>0.3.0</version>
  <description>Offline tracked tractor navigation and web control for Raspberry Pi 4.</description>

  <maintainer email="asbcorp24@users.noreply.github.com">asbcorp24</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>python3-gpiozero</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
