[Unit]
Description=RobotLiDAR Orange Pi Zero SSD1315 Status Display
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/robotlidar/orange_pi_zero_camera
Environment=PYTHONUNBUFFERED=1
Environment=ORANGE_PI_CAMERA_CONFIG=/etc/robotlidar/orange-pi-zero-camera.json
ExecStart=/usr/local/bin/python3.8 /opt/robotlidar/orange_pi_zero_camera/oled_ssd1315.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
