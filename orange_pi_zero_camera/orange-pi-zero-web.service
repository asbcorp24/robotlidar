[Unit]
Description=RobotLiDAR Orange Pi Zero Web Config
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/robotlidar/orange_pi_zero_camera
Environment=ORANGE_PI_CAMERA_CONFIG=/etc/robotlidar/orange-pi-zero-camera.json
Environment=ORANGE_PI_WEB_HOST=0.0.0.0
Environment=ORANGE_PI_WEB_PORT=8088
ExecStart=/usr/local/bin/python3.8 /opt/robotlidar/orange_pi_zero_camera/web_config.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
