[Unit]
Description=RobotLiDAR Orange Pi Zero OLED Status Display
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/robotlidar/orange_pi_zero_camera
Environment=PYTHONUNBUFFERED=1
Environment=ORANGE_PI_CAMERA_CONFIG=/etc/robotlidar/orange-pi-zero-camera.json
ExecStart=/usr/bin/python3 /opt/robotlidar/orange_pi_zero_camera/oled_display.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
