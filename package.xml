<?xml version="1.0"?>
<package format="3">
  <name>robotlidar</name>
  <version>0.1.0</version>
  <description>Offline tracked tractor control, Hall odometry and navigation support for Raspberry Pi 4.</description>

  <maintainer email="asbcorp24@users.noreply.github.com">asbcorp24</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-gpiozero</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
